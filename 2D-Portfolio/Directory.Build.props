<?xml version="1.0" encoding="utf-8"?>
<!-- 솔루션 공통 빌드 설정. 모든 프로젝트·구성에 적용된다. -->
<Project>
  <PropertyGroup>
    <!-- 산출물: Exe\<플랫폼>\<구성>\<프로젝트>\ — 앱별로 필요한 DLL 만 함께 둔다 -->
    <OutDir>$(MSBuildThisFileDirectory)Exe\$(Platform)\$(Configuration)\$(MSBuildProjectName)\</OutDir>
    <!-- 중간 파일: Temp\<플랫폼>\<프로젝트>\<구성>\ -->
    <IntDir>$(MSBuildThisFileDirectory)Temp\$(Platform)\$(MSBuildProjectName)\$(Configuration)\</IntDir>
  </PropertyGroup>
</Project>
